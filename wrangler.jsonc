{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klasma",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "klasma.huizhi.ink",
      "custom_domain": true
    }
  ]
}
